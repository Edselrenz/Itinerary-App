# ==============================================================================
# Monorepo Master .gitignore: Nueva Ecija Travel Itinerary
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
*.env
.env.local
.env.*.local
*.pem
*.key
client_secret*.json

# --- Python & Testing Artifacts ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/
.nox/

# --- Databases & Local State ---
*.db
*.sqlite
*.sqlite3
data/raw/*
!data/raw/.gitkeep
*.sql.gz
*.dump

# --- Node / Ionic / Angular Dependencies & Build Outputs ---
node_modules/
www/
dist/
.angular/
.angular/cache/
out-tsc/
bazel-out/
.ionic/
.nx/cache/

# --- Mobile Builds (Capacitor / Android / iOS) ---
android/app/build/
ios/App/Pods/
platforms/
plugins/

# --- Scratch, Binaries & Temporary Investigation Files ---
scratch/
*.bin
*.tmp
*.tmp.*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
figma_strings.txt

# --- IDE & Editor Configurations ---
.agents/
.idea/
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
UserInterfaceState.xcuserstate
