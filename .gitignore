# ==============================================================================
# Monorepo Master .gitignore: Nueva Ecija Travel Itinerary
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
*.env
.env.*
!.env.example
.env.local
.env.*.local
backend/.env

# Angular Environment Overrides (Preserves prod template; ignores custom local/secret configs)
**/src/environments/environment.local.ts
**/src/environments/environment.*.local.ts
**/src/environments/environment.*.secret.ts
!**/src/environments/environment.example.ts
!**/src/environments/environment.prod.ts

# Cloudflare Tunnels & Public Exposure Credentials
.cloudflared/
*.tunnel.json
cert.pem

# Cloud, Firebase & OAuth Service Accounts
client_secret*.json
*service-account*.json
*credentials*.json
**/google-services.json
**/GoogleService-Info.plist

# Cryptographic Keys & Certificates
*.pem
*.key
*.crt
*.pfx
*.p8
id_rsa*
id_ed25519*

# --- Mobile Builds & Signing (Capacitor / Android / iOS) ---
.capacitor/
android/app/build/
android/.gradle/
android/captures/
**/local.properties
**/key.properties
*.keystore
*.jks
ios/App/Pods/
ios/App/build/
*.p12
*.cer
*.mobileprovision
*.apk
*.aab
*.ipa
platforms/
plugins/

# --- Python & Testing Artifacts ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.coverage
htmlcov/
.nox/

# --- Databases, Docker & Local State ---
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
data/raw/*
!data/raw/.gitkeep
docker-compose.override.yml

# --- Node / Ionic / Angular Dependencies & Build Outputs ---
node_modules/
www/
dist/
.angular/
.angular/cache/
out-tsc/
bazel-out/
.ionic/
.nx/cache/

# --- Scratch, Binaries & Temporary Investigation Files ---
scratch/
*.bin
*.tmp
*.tmp.*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
figma_strings.txt

# --- IDE & Editor Configurations ---
.agents/
.idea/
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
UserInterfaceState.xcuserstate