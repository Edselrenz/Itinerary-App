# Nueva Ecija Travel Itinerary — Backend Environment Template
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://ne_travel_user:change_me_local_only@127.0.0.1:5432/nueva_ecija_travel
# For quick local testing without PostgreSQL, SQLite can also be used:
# DATABASE_URL=sqlite:///./nueva_ecija_travel.db
JWT_SECRET_KEY=replace_with_64_char_hex_generated_via_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:8100","http://localhost:4200","capacitor://localhost","http://localhost","https://edselrenz.github.io"]
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ENABLE_APPLE_AUTH=false
DEFAULT_DEST_RADIUS_KM=25.0

# Google Maps Platform (New Places API & Routes API)
# Optional: If omitted, backend gracefully uses OSRM and curated provincial POI datasets.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_CACHE_TTL_HOURS=168
GOOGLE_DETAILS_CACHE_TTL_HOURS=24
GOOGLE_ROUTES_CACHE_TTL_HOURS=336

# Optional: Cloudflare Worker Reverse Proxy Auto-Sync (Option 2)
# If provided, scripts/start_server.ps1 will automatically push live Cloudflare/ngrok tunnels
# to your Cloudflare Worker KV on startup, providing a permanent zero-touch URL for GitHub Pages.
# WORKER_SYNC_URL=https://ne-itinerary-api.<your-subdomain>.workers.dev
# WORKER_SYNC_KEY=your_chosen_admin_sync_secret_key
